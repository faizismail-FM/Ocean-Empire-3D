# Optional. Leave empty to play with local browser persistence only.
# When both values are set the game will also sync saves to Supabase
# (see supabase/migrations for the schema). Only the public anon key belongs here;
# never put the service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: enables the AI history assistant on encyclopedia pages (server-side only, never sent to the browser).
# Without it the assistant section explains that it is not enabled and the encyclopedia works as usual.
ANTHROPIC_API_KEY=
